meta {
  name: Reject Invalid Type
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/schedules
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  X-Tenant-ID: {{tenant_id}}
}

body:json {
  {
    "type": "yearly",
    "cron_expr": "0 0 1 1 *",
    "focus": "should fail"
  }
}

script:post-response {
  test("Status code is 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  const body = res.getBody();
  test("Error message mentions invalid type", function () {
    expect(body.error).to.match(/type/i);
  });

  console.log("Validation error:", JSON.stringify(body));
}