# ── Host Machine Configuration ──────────────────────────────────────
# Copy this to .env and adjust for your environment.
# For the devcontainer, docker-compose sets database vars automatically —
# you only need .env for the DashScope keys.

# Database
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# DashScope LLM (chat) — get your key at https://dashscope.console.aliyun.com/
# Use the public OpenAI-compatible endpoint:
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-your-api-key-here

# DashScope Embeddings — native API (different endpoint and format from chat)
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_EMBEDDING_API_KEY=sk-your-api-key-here

# LLM models
LLM_MODEL=qwen-max
EMBEDDING_MODEL=text-embedding-v4

# Agent loop bounds
MAX_TOOL_CALLS=10
MAX_LLM_CALLS=15
MAX_EXECUTION_MINUTES=10