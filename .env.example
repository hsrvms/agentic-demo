# Database
DATABASE_URL=postgres://platform:platform@localhost:5432/platform?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# DashScope API (https://dashscope.console.aliyun.com/)
DASHSCOPE_API_KEY=sk-your-api-key-here

# LLM models
LLM_MODEL=qwen-max
EMBEDDING_MODEL=text-embedding-v3

# Agent loop bounds
MAX_TOOL_CALLS=10
MAX_LLM_CALLS=15
MAX_EXECUTION_MINUTES=10
