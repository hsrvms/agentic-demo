# ── Host Machine Configuration ──────────────────────────────────────
# Copy this to .env and adjust for your environment.
# For the devcontainer, docker-compose sets database vars automatically —
# you only need .env for the DashScope keys.

# Database
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# DashScope LLM (chat) — get your key at https://dashscope.console.aliyun.com/
# Use the public OpenAI-compatible endpoint:
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-your-api-key-here

# DashScope Embeddings — native API (different endpoint and format from chat)
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_EMBEDDING_API_KEY=sk-your-api-key-here

# LLM models
LLM_MODEL=qwen-max
EMBEDDING_MODEL=text-embedding-v4

# Agent loop bounds
MAX_TOOL_CALLS=10
MAX_LLM_CALLS=15
MAX_EXECUTION_MINUTES=10


# SMTP (optional — omit for log-only mode)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@yourdomain.com

# S3-compatible object storage (uploaded file bytes)
# MinIO in development; Cloudflare R2 or AWS S3 in production — only these
# vars change, the adapter is identical.
# MinIO (dev):
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=platform
S3_USE_SSL=false
# Cloudflare R2 (prod):
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=<r2-access-key>
# S3_SECRET_ACCESS_KEY=<r2-secret-key>
# S3_REGION=auto
# S3_BUCKET=platform
# S3_USE_SSL=true
