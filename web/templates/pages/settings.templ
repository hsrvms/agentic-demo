package pages

import "fmt"

import "github.com/agentic-demo/platform/internal/webui"
import "github.com/agentic-demo/platform/web/templates/layouts"

templ Settings(data webui.SettingsData, flashes []webui.Flash) {
	@layouts.Base("Settings", flashes) {
		<div class="max-w-5xl mx-auto space-y-6">
			<div>
				<h1 class="text-3xl font-bold tracking-tight">Settings</h1>
				<p class="text-content-secondary mt-1">Tenant information and budget configuration</p>
			</div>

			// Tenant info — read-only.
			<div class="bg-surface-card border border-border rounded-lg shadow-sm p-6">
				<h2 class="text-xl font-semibold mb-4">Tenant Information</h2>
				<dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
					<div>
						<dt class="text-sm font-medium text-content-secondary">Name</dt>
						<dd class="text-base text-content mt-1">{ data.TenantName }</dd>
					</div>
					<div>
						<dt class="text-sm font-medium text-content-secondary">Tenant ID</dt>
						<dd class="text-base font-mono text-content mt-1">{ data.TenantID }</dd>
					</div>
					<div>
						<dt class="text-sm font-medium text-content-secondary">Status</dt>
						<dd class="mt-1">
							<span class={ statusBadgeClass(data.TenantStatusIntent) }>
								{ data.TenantStatusLabel }
							</span>
						</dd>
					</div>
					<div>
						<dt class="text-sm font-medium text-content-secondary">Created</dt>
						<dd class="text-base text-content mt-1">{ data.CreatedAt }</dd>
					</div>
				</dl>
			</div>

			// Budget status — live, shown to everyone.
			<div class="bg-surface-card border border-border rounded-lg shadow-sm p-6">
				<div class="flex items-center justify-between mb-4">
					<h2 class="text-xl font-semibold">Monthly Budget</h2>
					<span class={ budgetPercentClass(data.BudgetIntent) }>
						{ fmt.Sprintf("%.0f%% used", data.PercentUsed) }
					</span>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-4">
					<div>
						<p class="text-sm font-medium text-content-secondary">Monthly Budget</p>
						<p class="text-2xl font-bold text-content mt-1">{ data.MonthlyBudget }</p>
					</div>
					<div>
						<p class="text-sm font-medium text-content-secondary">Spent MTD</p>
						<p class="text-2xl font-bold text-content mt-1">{ data.MTDCost }</p>
					</div>
					<div>
						<p class="text-sm font-medium text-content-secondary">Remaining</p>
						<p class="text-2xl font-bold text-content mt-1">{ data.Remaining }</p>
					</div>
				</div>

				// Progress bar track.
				<div class="w-full bg-surface-page rounded-full h-3 overflow-hidden" role="progressbar" aria-valuenow={ fmt.Sprintf("%.0f", data.PercentUsed) } aria-valuemin="0" aria-valuemax="100">
					<div
						class={ progressBarClass(data.BudgetIntent) }
						style={ fmt.Sprintf("width: %.0f%%", clampPercent(data.PercentUsed)) }
					></div>
				</div>

				if data.BudgetExceeded {
					<div class="mt-3 flex items-center gap-2 text-sm text-intent-error" role="alert">
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
						</svg>
						<span>Budget exceeded — LLM calls are blocked until next billing period or budget increase.</span>
					</div>
				}
			</div>

			// Budget editing form — admins only.
			if data.IsAdmin {
				<div class="bg-surface-card border border-border rounded-lg shadow-sm p-6" id="budget-form-section">
					<h2 class="text-xl font-semibold mb-1">Update Budget</h2>
					<p class="text-sm text-content-secondary mb-4">Set the maximum monthly spend for this tenant (in USD).</p>

					<div id="budget-form-error"></div>

					<form
						hx-post="/settings/budget"
						hx-target="#budget-form-error"
						hx-swap="innerHTML"
						class="space-y-5"
					>
						<input type="hidden" name="_csrf" value={ data.CSRFToken }/>

						<div class="space-y-1">
							<label for="monthly_budget_usd" class="block text-sm font-medium text-content">
								Monthly Budget (USD)
							</label>
							<div class="relative">
								<span class="absolute inset-y-0 left-0 flex items-center pl-3 text-content-muted" aria-hidden="true">$</span>
								<input
									id="monthly_budget_usd"
									name="monthly_budget_usd"
									type="number"
									inputmode="decimal"
									step="0.01"
									min="0"
									autocomplete="off"
									value={ budgetInputValue(data.MonthlyBudget) }
									class="block w-full rounded-lg border border-border bg-surface-card pl-8 pr-3 py-2 text-sm text-content focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-colors"
								/>
							</div>
						</div>

						<button
							type="submit"
							class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-on shadow-sm hover:bg-primary-hover focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors"
						>
							<span class="htmx-indicator:hidden">Save Budget</span>
							<span class="htmx-indicator:flex hidden items-center gap-2">
								<svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
									<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
								</svg>
								Saving…
							</span>
						</button>
					</form>
				</div>
			}
		</div>
	}
}

// budgetInputValue strips the leading "$" from the formatted value so it can
// be used as the numeric input's value.
func budgetInputValue(formatted string) string {
	if len(formatted) > 0 && formatted[0] == '$' {
		return formatted[1:]
	}
	return formatted
}

// statusBadgeClass returns the full class string for a tenant status badge.
func statusBadgeClass(intent string) string {
	base := "inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium "
	switch intent {
	case "success":
		return base + "bg-intent-success/10 text-intent-success"
	case "warning":
		return base + "bg-intent-warning/10 text-intent-warning"
	case "error":
		return base + "bg-intent-error/10 text-intent-error"
	default:
		return base + "bg-surface-page text-content-muted"
	}
}

// budgetPercentClass returns the class string for the budget usage percent.
func budgetPercentClass(intent string) string {
	switch intent {
	case "success":
		return "text-sm font-medium text-intent-success"
	case "warning":
		return "text-sm font-medium text-intent-warning"
	default:
		return "text-sm font-medium text-intent-error"
	}
}

// progressBarClass returns the class string for the budget progress bar fill.
func progressBarClass(intent string) string {
	switch intent {
	case "success":
		return "h-3 rounded-full transition-all duration-300 bg-intent-success"
	case "warning":
		return "h-3 rounded-full transition-all duration-300 bg-intent-warning"
	default:
		return "h-3 rounded-full transition-all duration-300 bg-intent-error"
	}
}
