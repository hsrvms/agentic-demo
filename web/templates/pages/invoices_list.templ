package pages

import "fmt"

import "github.com/agentic-demo/platform/internal/webui"
import "github.com/agentic-demo/platform/web/templates/layouts"

templ InvoicesList(data webui.InvoiceListData, flashes []webui.Flash) {
	@layouts.Base("Invoices", flashes) {
		<div class="space-y-6">
			<div>
				<h1 class="text-3xl font-bold tracking-tight">Invoices</h1>
				if data.TenantName != "" {
					<p class="text-content-secondary mt-1">{ data.TenantName }</p>
				}
			</div>

			if len(data.Invoices) == 0 && data.Page == 1 {
				@InvoicesEmptyState()
			} else {
				<div class="bg-surface-card border border-border rounded-lg shadow-sm overflow-hidden">
					<div class="overflow-x-auto">
						<table class="w-full text-sm">
							<thead>
								<tr class="border-b border-border">
									<th class="text-left py-3 px-4 font-medium text-content-secondary">Period</th>
									<th class="text-left py-3 px-4 font-medium text-content-secondary">Status</th>
									<th class="text-right py-3 px-4 font-medium text-content-secondary">Total Cost</th>
								</tr>
							</thead>
							<tbody id="invoices-body">
								for _, inv := range data.Invoices {
									@InvoiceRow(inv)
								}
							</tbody>
						</table>
					</div>
				</div>

				if data.HasMore {
					<div
						id="invoices-pagination"
						hx-get={ fmt.Sprintf("/invoices?page=%d", data.NextPage) }
						hx-trigger="revealed"
						hx-target="#invoices-body"
						hx-swap="beforeend"
					>
						<div class="flex justify-center py-4">
							<div class="htmx-indicator flex items-center gap-2 text-sm text-content-muted">
								<svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none">
									<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
									<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
								</svg>
								Loading more…
							</div>
						</div>
					</div>
				}
			}
		</div>
	}
}

templ InvoicesEmptyState() {
	<div class="flex flex-col items-center justify-center py-16 px-4 text-center bg-surface-card border border-border rounded-lg shadow-sm">
		<div class="text-content-muted mb-4">
			<svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
			</svg>
		</div>
		<h3 class="text-lg font-medium text-content mb-1">No invoices yet</h3>
		<p class="text-sm text-content-secondary mb-2 max-w-sm">No invoices yet. Invoices are generated at the start of each billing period.</p>
	</div>
}

templ InvoiceRow(inv webui.InvoiceItem) {
	<tr class="border-b border-border hover:bg-surface-page transition-colors">
		<td class="py-3 px-4">
			<a href={ "/invoices/" + inv.ID } class="text-content font-medium hover:text-primary transition-colors">{ inv.PeriodLabel }</a>
		</td>
		<td class="py-3 px-4">
			@InvoiceStatusBadge(inv.StatusLabel, inv.StatusIntent)
		</td>
		<td class="py-3 px-4 text-right font-medium text-content">{ inv.TotalCostUSD }</td>
	</tr>
}

templ InvoiceStatusBadge(label string, intent string) {
	<span class={ fmt.Sprintf("inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium %s", invoiceStatusClass(intent)) }>
		{ label }
	</span>
}

// invoiceStatusClass maps an invoice status intent to badge color classes.
// draft=muted, issued=info, paid=success, overdue=error.
func invoiceStatusClass(intent string) string {
	switch intent {
	case "info":
		return "bg-intent-info/10 text-intent-info"
	case "success":
		return "bg-intent-success/10 text-intent-success"
	case "error":
		return "bg-intent-error/10 text-intent-error"
	default:
		return "bg-content-muted/10 text-content-muted"
	}
}

// InvoiceRowsFragment renders just the table rows for HTMX infinite-scroll
// pagination. The page's sentinel element swaps these rows into the table body.
templ InvoiceRowsFragment(invoices []webui.InvoiceItem) {
	for _, inv := range invoices {
		@InvoiceRow(inv)
	}
}