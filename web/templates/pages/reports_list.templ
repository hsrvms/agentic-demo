package pages

import "github.com/agentic-demo/platform/internal/webui"
import "github.com/agentic-demo/platform/web/templates/layouts"
import "fmt"

templ ReportsList(data webui.ReportListData, genForm webui.GenerateReportForm, flashes []webui.Flash) {
	@layouts.Base("Reports", flashes) {
		<div class="space-y-6" x-data="{ genOpen: false }">
			<div class="flex items-center justify-between">
				<div>
					<h1 class="text-3xl font-bold tracking-tight">Reports</h1>
					<p class="text-content-secondary mt-1">Browse generated strategic reports</p>
				</div>
				<button
					@click="genOpen = true"
					class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-on shadow-sm hover:bg-primary-hover focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors"
				>
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
					</svg>
					Generate Report
				</button>
			</div>

			@GenerateReportModal(genForm)

			if len(data.Reports) == 0 && data.Page == 1 {
				@ReportsEmptyState()
			} else {
				<div class="bg-surface-card border border-border rounded-lg shadow-sm overflow-hidden">
					<div class="overflow-x-auto">
						<table class="w-full text-sm">
							<thead>
								<tr class="border-b border-border">
									<th class="text-left py-3 px-4 font-medium text-content-secondary">Title</th>
									<th class="text-left py-3 px-4 font-medium text-content-secondary">Type</th>
									<th class="text-left py-3 px-4 font-medium text-content-secondary">Focus Areas</th>
									<th class="text-left py-3 px-4 font-medium text-content-secondary">Generated</th>
								</tr>
							</thead>
							<tbody
								id="reports-body"
								if data.Page == 1 && !data.HasMore {
									hx-get="/reports"
									hx-trigger="every 10s"
									hx-target="#reports-body"
									hx-swap="innerHTML"
								}
							>
								for _, r := range data.Reports {
									@ReportRow(r)
								}
							</tbody>
						</table>
					</div>
				</div>

				if data.HasMore {
					<div
						id="reports-pagination"
						hx-get={ fmt.Sprintf("/reports?page=%d", data.NextPage) }
						hx-trigger="revealed"
						hx-target="#reports-body"
						hx-swap="beforeend"
					>
						<div class="flex justify-center py-4">
							<div class="htmx-indicator flex items-center gap-2 text-sm text-content-muted">
								<svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none">
									<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
									<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
								</svg>
								Loading more…
							</div>
						</div>
					</div>
				}
			}
		</div>
	}
}

// GenerateReportModal renders the Alpine.js modal with the on-demand report
// generation form. The form submits via HTMX to POST /reports/generate and
// swaps its own body with the response (success or error fragment).
templ GenerateReportModal(genForm webui.GenerateReportForm) {
	<div
		x-show="genOpen"
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0"
		x-transition:enter-end="opacity-100"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100"
		x-transition:leave-end="opacity-0"
		class="fixed inset-0 z-50 flex items-center justify-center p-4"
		x-cloak
	>
		<div class="absolute inset-0 bg-black/50" @click="genOpen = false"></div>
		<div
			x-show="genOpen"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 scale-95"
			x-transition:enter-end="opacity-100 scale-100"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="opacity-100 scale-100"
			x-transition:leave-end="opacity-0 scale-95"
			@keydown.escape.window="genOpen = false"
			role="dialog"
			aria-modal="true"
			aria-labelledby="generate-report-title"
			class="relative bg-surface-raised border border-border rounded-xl shadow-lg p-6 w-full max-w-md"
		>
			<div class="flex items-center justify-between mb-4">
				<h2 id="generate-report-title" class="text-lg font-semibold text-content">Generate Report</h2>
				<button @click="genOpen = false" aria-label="Close" class="p-1 rounded-lg text-content-muted hover:text-content transition-colors">
					<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
					</svg>
				</button>
			</div>

			<div id="gen-form-body">
				<form
					hx-post="/reports/generate"
					hx-target="#gen-form-body"
					hx-swap="innerHTML"
					hx-indicator="#gen-submit-spinner"
					class="space-y-4"
				>
					<input type="hidden" name="_csrf" value={ genForm.CSRFToken }/>

					<div class="space-y-1">
						<label for="report_type" class="block text-sm font-medium text-content">Report Type</label>
						<select
							id="report_type"
							name="report_type"
							class="block w-full rounded-lg border border-border bg-surface-card px-3 py-2 text-sm text-content focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-colors"
						>
							for _, opt := range genForm.TypeOptions {
								<option value={ opt.Value } selected={ opt.Value == "on_demand" }>{ opt.Label }</option>
							}
						</select>
						<p class="text-xs text-content-muted">Signals for daily, trends for weekly/monthly, or an immediate on-demand report.</p>
					</div>

					<div class="space-y-1">
						<label for="focus" class="block text-sm font-medium text-content">Focus Areas</label>
						<textarea
							id="focus"
							name="focus"
							rows="3"
							placeholder="Optional: what should this report focus on?"
							class="block w-full rounded-lg border border-border bg-surface-card px-3 py-2 text-sm text-content placeholder:text-content-muted focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-colors"
						></textarea>
						<p class="text-xs text-content-muted">Leave blank for a general report.</p>
					</div>

					<div class="space-y-1">
						<label for="schedule_id" class="block text-sm font-medium text-content">Schedule Reference</label>
						<input
							id="schedule_id"
							name="schedule_id"
							type="text"
							placeholder="Optional: schedule ID this report references"
							class="block w-full rounded-lg border border-border bg-surface-card px-3 py-2 text-sm text-content placeholder:text-content-muted focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-colors"
						/>
						<p class="text-xs text-content-muted">Optional. Link this report to an existing schedule.</p>
					</div>

					<div class="flex items-center gap-3 pt-2">
						<button
							type="submit"
							class="inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-on shadow-sm hover:bg-primary-hover focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
						>
							<span class="htmx-indicator:hidden">Generate</span>
							<span id="gen-submit-spinner" class="htmx-indicator:flex hidden items-center gap-2">
								<svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none">
									<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
									<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
								</svg>
								Starting…
							</span>
						</button>
						<button
							type="button"
							@click="genOpen = false"
							class="inline-flex items-center justify-center rounded-lg border border-border bg-surface-card px-4 py-2 text-sm font-medium text-content shadow-sm hover:bg-surface-page focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors"
						>
							Cancel
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}

templ ReportsEmptyState() {
	<div class="flex flex-col items-center justify-center py-16 px-4 text-center bg-surface-card border border-border rounded-lg shadow-sm">
		<div class="text-content-muted mb-4">
			<svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
			</svg>
		</div>
		<h3 class="text-lg font-medium text-content mb-1">No reports yet</h3>
		<p class="text-sm text-content-secondary mb-2 max-w-sm">No reports yet. Generate one to get started.</p>
	</div>
}

templ ReportRow(r webui.ReportItem) {
	<tr class="border-b border-border hover:bg-surface-page transition-colors">
		<td class="py-3 px-4">
			<a href={ "/reports/" + r.ID } class="text-content font-medium hover:text-primary transition-colors">{ r.Title }</a>
		</td>
		<td class="py-3 px-4">
			@TypeBadge(r.TypeLabel, r.TypeIntent)
		</td>
		<td class="py-3 px-4 text-content-secondary">
			if r.Focus != "" {
				{ r.Focus }
			} else {
				<span class="text-content-muted">—</span>
			}
		</td>
		<td class="py-3 px-4 text-content-secondary text-xs whitespace-nowrap">{ r.GeneratedAt }</td>
	</tr>
}

templ TypeBadge(label string, intent string) {
	<span class={ fmt.Sprintf("inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium %s", reportTypeClass(intent)) }>
		{ label }
	</span>
}

// reportTypeClass maps a report type intent to badge color classes.
func reportTypeClass(intent string) string {
	switch intent {
	case "info":
		return "bg-intent-info/10 text-intent-info"
	case "warning":
		return "bg-intent-warning/10 text-intent-warning"
	default:
		return "bg-primary-subtle text-primary"
	}
}

// ReportRowsFragment renders just the table rows for HTMX pagination.
templ ReportRowsFragment(reports []webui.ReportItem) {
	for _, r := range reports {
		@ReportRow(r)
	}
}

// GenerateSuccessFragment confirms the async report job was enqueued.
templ GenerateSuccessFragment() {
	<div class="text-center py-4">
		<svg class="mx-auto h-10 w-10 text-intent-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
		</svg>
		<p class="font-medium text-content mt-3">Report generation started</p>
		<p class="text-sm text-content-secondary mt-1">Your report will appear here once the worker finishes.</p>
	</div>
}