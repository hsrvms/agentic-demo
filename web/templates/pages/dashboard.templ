package pages

import "fmt"

import "github.com/agentic-demo/platform/internal/webui"
import "github.com/agentic-demo/platform/web/templates/layouts"

templ Dashboard(data webui.DashboardData, flashes []webui.Flash) {
	@layouts.Base("Dashboard", flashes) {
		<div class="space-y-6">
			<div>
				<h1 class="text-3xl font-bold tracking-tight">Dashboard</h1>
				if data.TenantName != "" {
					<p class="text-content-secondary mt-1">{ data.TenantName }</p>
				}
			</div>

			// Stat cards grid.
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
				// Total cost MTD.
				<div class="bg-surface-card border border-border rounded-lg shadow-sm p-6">
					<p class="text-sm font-medium text-content-secondary">Total Cost MTD</p>
					<p class="text-2xl font-bold text-content mt-1">{ data.CostFormatted }</p>
					<p class="text-sm text-content-muted mt-2">{ data.TokensFormatted } tokens used</p>
				</div>

				// Reports generated.
				<div class="bg-surface-card border border-border rounded-lg shadow-sm p-6">
					<p class="text-sm font-medium text-content-secondary">Reports Generated</p>
					<p class="text-2xl font-bold text-content mt-1">{ fmt.Sprintf("%d", data.ReportsCount) }</p>
					<a href="/reports" class="text-sm text-primary hover:text-primary-hover mt-2 inline-block">
						View reports →
					</a>
				</div>

				// Active sources.
				<div class="bg-surface-card border border-border rounded-lg shadow-sm p-6">
					<p class="text-sm font-medium text-content-secondary">Active Sources</p>
					<p class="text-2xl font-bold text-content mt-1">{ fmt.Sprintf("%d", data.ActiveSources) }</p>
					<a href="/sources" class="text-sm text-primary hover:text-primary-hover mt-2 inline-block">
						Manage sources →
					</a>
				</div>
			</div>

			// Budget progress section.
			<div class="bg-surface-card border border-border rounded-lg shadow-sm p-6">
				<div class="flex items-center justify-between mb-3">
					<h3 class="text-lg font-medium text-content">Budget Usage</h3>
					<span
						class="text-sm font-medium"
						if data.BudgetIntent == "success" {
							class="text-intent-success"
						} else if data.BudgetIntent == "warning" {
							class="text-intent-warning"
						} else {
							class="text-intent-error"
						}
					>
						{ fmt.Sprintf("%.0f%%", data.BudgetPercent) }
					</span>
				</div>

				// Progress bar track.
				<div class="w-full bg-surface-page rounded-full h-3 overflow-hidden" role="progressbar" aria-valuenow={ fmt.Sprintf("%.0f", data.BudgetPercent) } aria-valuemin="0" aria-valuemax="100">
					<div
						class="h-3 rounded-full transition-all duration-300"
						if data.BudgetIntent == "success" {
							class="bg-intent-success"
						} else if data.BudgetIntent == "warning" {
							class="bg-intent-warning"
						} else {
							class="bg-intent-error"
						}
						style={ fmt.Sprintf("width: %.0f%%", clampPercent(data.BudgetPercent)) }
					></div>
				</div>

				if data.BudgetExceeded {
					<div class="mt-3 flex items-center gap-2 text-sm text-intent-error">
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
						</svg>
						<span>Budget exceeded — LLM calls are blocked until next billing period or budget increase.</span>
					</div>
				} else if data.BudgetPercent >= 80 {
					<div class="mt-3 flex items-center gap-2 text-sm text-intent-warning">
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
						</svg>
						<span>Approaching budget limit — consider increasing your monthly budget.</span>
					</div>
				}
			</div>
		</div>
	}
}

// clampPercent caps the visual width of the progress bar at 100%.
func clampPercent(p float64) float64 {
	if p > 100 {
		return 100
	}
	if p < 0 {
		return 0
	}
	return p
}
