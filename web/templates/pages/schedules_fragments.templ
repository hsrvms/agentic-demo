package pages

import "github.com/agentic-demo/platform/internal/webui"
import "fmt"

// ScheduleRow renders a single schedule row. The toggle button posts to the
// toggle endpoint and swaps the whole row with the returned fragment so the
// enabled/disabled state updates in place.
templ ScheduleRow(s webui.ScheduleItem, csrfToken string) {
	<tr class="border-b border-border hover:bg-surface-page transition-colors">
		<td class="py-3 px-4">
			@TypeBadge(s.TypeLabel, s.TypeIntent)
		</td>
		<td class="py-3 px-4">
			<span class="font-mono text-xs text-content">{ s.CronExpr }</span>
			<span class="block text-xs text-content-muted mt-0.5">{ s.CronHuman }</span>
		</td>
		<td class="py-3 px-4 text-content-secondary">
			if s.Focus != "" {
				<span class="line-clamp-2">{ s.Focus }</span>
			} else {
				<span class="text-content-muted">—</span>
			}
		</td>
		<td class="py-3 px-4 text-content-secondary">{ s.FormatLabel }</td>
		<td class="py-3 px-4">
			@ScheduleToggle(s, csrfToken)
		</td>
		<td class="py-3 px-4 text-right">
			<div class="inline-flex items-center gap-1">
				<a
					href={ "/schedules/" + s.ID + "/edit" }
					class="inline-flex items-center gap-1 rounded-lg px-2 py-1 text-xs font-medium text-content-secondary hover:bg-surface-page hover:text-content focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors"
					aria-label={ "Edit " + s.TypeLabel + " schedule" }
				>
					<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
					</svg>
					Edit
				</a>
				<button
					hx-delete={ "/schedules/" + s.ID }
					hx-target="closest tr"
					hx-swap="outerHTML"
					hx-confirm="Delete this schedule?"
					hx-headers={ fmt.Sprintf(`{"X-CSRF-Token": "%s"}`, csrfToken) }
					class="inline-flex items-center gap-1 rounded-lg px-2 py-1 text-xs font-medium text-content-muted hover:text-intent-error hover:bg-intent-error/5 focus:ring-2 focus:ring-intent-error focus:ring-offset-2 transition-colors"
					aria-label={ "Delete " + s.TypeLabel + " schedule" }
				>
					<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
					</svg>
					Delete
				</button>
			</div>
		</td>
	</tr>
}

// ScheduleToggle renders an accessible on/off switch that toggles the
// schedule's enabled state via HTMX and swaps the parent row.
templ ScheduleToggle(s webui.ScheduleItem, csrfToken string) {
	<button
		hx-post={ "/schedules/" + s.ID + "/toggle" }
		hx-target="closest tr"
		hx-swap="outerHTML"
		hx-headers={ fmt.Sprintf(`{"X-CSRF-Token": "%s"}`, csrfToken) }
		role="switch"
		aria-checked={ fmt.Sprintf("%v", s.Enabled) }
		aria-label={ "Toggle " + s.TypeLabel + " schedule" }
		class="relative inline-flex h-6 w-11 shrink-0 items-center rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
		if s.Enabled {
			class="bg-intent-success"
		} else {
			class="bg-border-strong"
		}
	>
		<span
			class={ fmt.Sprintf("inline-block h-4 w-4 transform rounded-full bg-white shadow transition-transform %s", scheduleKnob(s.Enabled)) }
		></span>
	</button>
}

// scheduleKnob returns the Tailwind transform class for the toggle knob position.
func scheduleKnob(enabled bool) string {
	if enabled {
		return "translate-x-6"
	}
	return "translate-x-1"
}

// ScheduleRowsFragment renders just the table rows for HTMX partial updates.
templ ScheduleRowsFragment(schedules []webui.ScheduleItem, csrfToken string) {
	for _, s := range schedules {
		@ScheduleRow(s, csrfToken)
	}
}

// ScheduleEmptyState renders the empty state when no schedules exist.
templ ScheduleEmptyState() {
	<div class="flex flex-col items-center justify-center py-16 px-4 text-center bg-surface-card border border-border rounded-lg shadow-sm">
		<div class="text-content-muted mb-4">
			<svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6 4A9.75 9.75 0 114.5 4.5 9.75 9.75 0 0119.5 19.5z"/>
			</svg>
		</div>
		<h3 class="text-lg font-medium text-content mb-1">No schedules configured</h3>
		<p class="text-sm text-content-secondary mb-6 max-w-sm">Create one to automate report generation.</p>
		<a
			href="/schedules/new"
			class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-on shadow-sm hover:bg-primary-hover focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors"
		>
			<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
			</svg>
			Add Schedule
		</a>
	</div>
}