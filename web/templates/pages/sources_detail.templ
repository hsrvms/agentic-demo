package pages

import "github.com/agentic-demo/platform/internal/webui"
import "github.com/agentic-demo/platform/web/templates/layouts"
import "fmt"

templ SourceDetail(data webui.SourceDetailData, csrfToken string, flashes []webui.Flash) {
	@layouts.Base("Source: " + data.Source.Name, flashes) {
		<div class="max-w-3xl mx-auto space-y-6">
			<div>
				<a href="/sources" class="text-sm text-primary hover:text-primary-hover transition-colors inline-flex items-center gap-1">
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
					</svg>
					Back to Sources
				</a>
			</div>

			<div class="flex items-center justify-between">
				<div class="flex items-center gap-3">
					<h1 class="text-3xl font-bold tracking-tight">{ data.Source.Name }</h1>
					@StatusBadge(data.Source.Status, data.Source.StatusIntent)
				</div>
				<div class="flex items-center gap-2">
					<a
						href={ "/sources/" + data.Source.ID + "/edit" }
						class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface-card px-3 py-2 text-sm font-medium text-content shadow-sm hover:bg-surface-page focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors"
					>
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
						</svg>
						Edit
					</a>
					<button
						hx-delete={ "/sources/" + data.Source.ID }
						hx-target="closest div"
						hx-swap="outerHTML"
						hx-confirm="Delete this source? This cannot be undone."
						hx-headers={ fmt.Sprintf(`{"X-CSRF-Token": "%s"}`, csrfToken) }
						class="inline-flex items-center gap-2 rounded-lg bg-intent-error px-3 py-2 text-sm font-medium text-white shadow-sm hover:opacity-90 focus:ring-2 focus:ring-intent-error focus:ring-offset-2 transition-colors"
					>
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
						</svg>
						Delete
					</button>
				</div>
			</div>

			// Source info card.
			<div class="bg-surface-card border border-border rounded-lg shadow-sm p-6 space-y-4">
				<h2 class="text-lg font-medium text-content">Details</h2>
				<dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<div>
						<dt class="text-sm font-medium text-content-secondary">Type</dt>
						<dd class="mt-1 text-sm text-content">{ data.Source.SourceLabel }</dd>
					</div>
					<div>
						<dt class="text-sm font-medium text-content-secondary">Status</dt>
						<dd class="mt-1">@StatusBadge(data.Source.Status, data.Source.StatusIntent)</dd>
					</div>
					<div>
						<dt class="text-sm font-medium text-content-secondary">Last Sync</dt>
						<dd class="mt-1 text-sm text-content">
							if data.Source.LastSyncAt != "" {
								<span>{ data.Source.LastSyncAt }</span>
							} else {
								<span class="text-content-muted">Never</span>
							}
						</dd>
					</div>
					<div>
						<dt class="text-sm font-medium text-content-secondary">Credentials</dt>
						<dd class="mt-1 text-sm text-content">
							if data.HasCredentials {
								<span class="text-intent-success">Configured</span>
							} else {
								<span class="text-content-muted">None</span>
							}
						</dd>
					</div>
				</dl>

				if data.ConfigJSON != "" && data.ConfigJSON != "{}" {
					<div>
						<dt class="text-sm font-medium text-content-secondary mb-2">Configuration</dt>
						<dd>
							<pre class="bg-surface-page border border-border rounded-lg p-3 text-xs font-mono text-content overflow-x-auto">{ data.ConfigJSON }</pre>
						</dd>
					</div>
				}
			</div>

			// Actions card.
			<div class="bg-surface-card border border-border rounded-lg shadow-sm p-6 space-y-4">
				<h2 class="text-lg font-medium text-content">Actions</h2>
				<div class="flex items-center gap-3">
					<button
						hx-post={ "/sources/" + data.Source.ID + "/test" }
						hx-target="#detail-status"
						hx-swap="innerHTML"
						hx-headers={ fmt.Sprintf(`{"X-CSRF-Token": "%s"}`, csrfToken) }
						class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface-card px-4 py-2 text-sm font-medium text-content shadow-sm hover:bg-surface-page focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors"
					>
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
						</svg>
						Test Connection
					</button>
					<button
						hx-post={ "/sources/" + data.Source.ID + "/sync" }
						hx-target="#detail-status"
						hx-swap="innerHTML"
						hx-headers={ fmt.Sprintf(`{"X-CSRF-Token": "%s"}`, csrfToken) }
						class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-on shadow-sm hover:bg-primary-hover focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors"
					>
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
						</svg>
						Sync Now
					</button>
				</div>
				<div id="detail-status"></div>
			</div>
		</div>
	}
}
